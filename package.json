{
  "name": "@samebase/alchemy-convex",
  "version": "0.6.1",
  "description": "The Convex plane for Alchemy v2: projects, deployments, environment variables, and the push of the functions",
  "keywords": [
    "alchemy",
    "cloudflare",
    "convex",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://github.com/samebase/alchemy-convex#readme",
  "bugs": {
    "url": "https://github.com/samebase/alchemy-convex/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/alchemy-convex.git"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp fmt --check && vp lint && pnpm run typecheck && vp test --run",
    "typecheck": "tsc --noEmit",
    "test": "vp test --run",
    "test:live": "node ./scripts/test-live.ts",
    "format": "vp fmt",
    "lint": "vp lint",
    "build": "vp pack",
    "prepack": "pnpm run build",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "@convex-dev/platform": "0.1.11"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@effect/platform-node": "4.0.4",
    "@effect/vitest": "4.0.4",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.83",
    "convex": "1.46.0",
    "convex-test": "0.0.60",
    "effect": "4.0.4",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.0",
    "alchemy": "2.0.0-beta.83",
    "convex": "^1.46.0",
    "effect": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.5"
}
